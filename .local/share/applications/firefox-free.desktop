[Desktop Entry]
Name=Firefox Free
GenericName=Web Browser
Comment=Unmanaged Firefox Container
# The %u allows it to accept URLs from other apps
# install.sh rewrites this to the absolute path (Exec does not expand $HOME)
Exec=firefox-free %u
Icon=firefox
Terminal=false
Type=Application
Categories=Network;WebBrowser;
StartupNotify=true
# This groups the windows correctly in the dock
StartupWMClass=firefox
MimeType=x-scheme-handler/unknown;x-scheme-handler/about;x-scheme-handler/https;x-scheme-handler/http;text/html;
